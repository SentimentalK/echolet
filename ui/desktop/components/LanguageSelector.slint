export struct SlintLanguageOptionData {
    locale: string,
    label: string,
    is_selected: bool,
}

export component LanguageSelector {
    in property <string> model_id: "";
    in property <string> current_label: "Auto";
    in property <[SlintLanguageOptionData]> options: [];
    in-out property <bool> is_expanded: false;

    callback language_selected(string, string);

    VerticalLayout {
        spacing: 6px;

        // Dropdown toggle bar
        Rectangle {
            height: 34px;
            border-radius: 8px;
            background: toggle_touch.has-hover ? #fafafa : #ffffff;
            border-width: 1px;
            border-color: root.is_expanded ? #18181b : #e4e4e7;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: space-between;

                Text {
                    text: root.current_label;
                    color: #09090b;
                    font-size: 12px;
                    font-weight: 500;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Text {
                    text: root.is_expanded ? "▲" : "▼";
                    color: #a1a1aa;
                    font-size: 9px;
                    vertical-alignment: center;
                }
            }

            toggle_touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.is_expanded = !root.is_expanded;
                }
            }
        }

        // Expanded list of language options
        if root.is_expanded: Rectangle {
            border-radius: 8px;
            background: #ffffff;
            border-width: 1px;
            border-color: #e4e4e7;
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #0000000f;
            clip: true;

            VerticalLayout {
                padding: 4px;
                spacing: 1px;

                for option in root.options: Rectangle {
                    height: 28px;
                    border-radius: 6px;
                    background: option.is_selected ? #f4f4f5 : (opt_touch.has-hover ? #fafafa : transparent);

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: space-between;

                        Text {
                            text: option.label;
                            color: option.is_selected ? #09090b : #3f3f46;
                            font-size: 12px;
                            font-weight: option.is_selected ? 600 : 400;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        if option.is_selected: Text {
                            text: "✓";
                            color: #09090b;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }

                    opt_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.is_expanded = false;
                            root.language_selected(root.model_id, option.locale);
                        }
                    }
                }
            }
        }
    }
}
