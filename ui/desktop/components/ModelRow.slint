import { ProgressRow } from "ProgressRow.slint";

export struct SlintModelRowData {
    id: string,
    label: string,
    verification_label: string,
    status_text: string,
    action_label: string,
    action_enabled: bool,
    selected: bool,
    is_in_progress: bool,
    progress_text: string,
    progress_percent: int,
}

export component ModelRow {
    in property <SlintModelRowData> model;
    callback action_clicked(string);

    height: 50px;

    Rectangle {
        border-radius: 10px;
        background: root.model.selected ? #fafafa : (row_hover.has-hover ? #fcfcfd : #ffffff);
        border-width: 1px;
        border-color: root.model.selected ? #18181b : (row_hover.has-hover ? #d4d4d8 : #e4e4e7);

        row_hover := TouchArea { }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 10px;
            spacing: 8px;
            alignment: space-between;

            // Model label and status/progress
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                width: 222px;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    Text {
                        text: root.model.label;
                        color: #09090b;
                        font-size: 12px;
                        font-weight: 600;
                        overflow: elide;
                        vertical-alignment: center;
                    }

                    if root.model.verification_label != "": Text {
                        text: "· " + root.model.verification_label;
                        color: #a1a1aa;
                        font-size: 10px;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }

                if root.model.is_in_progress: ProgressRow {
                    progress_text: root.model.progress_text;
                    progress_percent: root.model.progress_percent;
                }

                if !root.model.is_in_progress: Text {
                    text: root.model.status_text;
                    color: #71717a;
                    font-size: 10px;
                    overflow: elide;
                }
            }

            // Selected badge
            if root.model.selected: Rectangle {
                width: 76px;
                height: 24px;
                border-radius: 12px;
                background: #18181b;
                y: (parent.height - self.height) / 2;

                Text {
                    text: "✓ Selected";
                    color: #fafafa;
                    font-size: 10px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            // Outline action button
            if !root.model.selected && root.model.action_label != "": Rectangle {
                width: 76px;
                height: 26px;
                border-radius: 8px;
                background: !root.model.action_enabled ? #f4f4f5 : (action_touch.pressed ? #e4e4e7 : (action_touch.has-hover ? #f4f4f5 : #ffffff));
                border-width: 1px;
                border-color: !root.model.action_enabled ? #f4f4f5 : #e4e4e7;
                y: (parent.height - self.height) / 2;

                Text {
                    text: root.model.action_label;
                    color: !root.model.action_enabled ? #a1a1aa : #18181b;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    overflow: elide;
                }

                action_touch := TouchArea {
                    enabled: root.model.action_enabled;
                    mouse-cursor: pointer;
                    clicked => {
                        root.action_clicked(root.model.id);
                    }
                }
            }
        }
    }
}
