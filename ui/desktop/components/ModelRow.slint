import { ProgressRow } from "ProgressRow.slint";

export struct SlintModelRowData {
    id: string,
    label: string,
    verification_label: string,
    status_text: string,
    action_label: string,
    action_enabled: bool,
    selected: bool,
    is_in_progress: bool,
    progress_text: string,
    progress_percent: int,
}

export component ModelRow {
    in property <SlintModelRowData> model;
    callback action_clicked(string);

    height: 40px;

    Rectangle {
        border-radius: 6px;
        background: root.model.selected ? #27272a : #1f1f23;
        border-width: 1px;
        border-color: root.model.selected ? #3b82f6 : #2e2e33;

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 8px;
            alignment: space-between;

            // Model label and status/progress
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                width: 240px;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    Text {
                        text: root.model.label;
                        color: #f4f4f5;
                        font-size: 12px;
                        font-weight: 500;
                        overflow: elide;
                        vertical-alignment: center;
                    }

                    if root.model.verification_label != "": Text {
                        text: "· " + root.model.verification_label;
                        color: #71717a;
                        font-size: 10px;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }

                if root.model.is_in_progress: ProgressRow {
                    progress_text: root.model.progress_text;
                    progress_percent: root.model.progress_percent;
                }

                if !root.model.is_in_progress: Text {
                    text: root.model.status_text;
                    color: #a1a1aa;
                    font-size: 10px;
                    overflow: elide;
                }
            }

            // Action / Selection indicator
            if root.model.selected: Rectangle {
                width: 72px;
                height: 22px;
                border-radius: 4px;
                background: #1e3a8a;
                border-width: 1px;
                border-color: #3b82f6;

                Text {
                    text: "Selected";
                    color: #93c5fd;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            if !root.model.selected && root.model.action_label != "": Rectangle {
                width: 72px;
                height: 22px;
                border-radius: 4px;
                background: !root.model.action_enabled ? #27272a : (action_touch.pressed ? #1d4ed8 : (action_touch.has-hover ? #2563eb : #1d4ed8));
                border-width: 1px;
                border-color: !root.model.action_enabled ? #3f3f46 : #3b82f6;

                Text {
                    text: root.model.action_label;
                    color: !root.model.action_enabled ? #71717a : #ffffff;
                    font-size: 11px;
                    font-weight: 500;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    overflow: elide;
                }

                action_touch := TouchArea {
                    enabled: root.model.action_enabled;
                    clicked => {
                        root.action_clicked(root.model.id);
                    }
                }
            }
        }
    }
}
