export struct SlintModelRowData {
    id: string,
    label: string,
    verification_label: string,
    status_text: string,
    action_label: string,
    action_enabled: bool,
    selected: bool,
    is_in_progress: bool,
    progress_text: string,
    progress_percent: int,
}

export component ModelRow {
    in property <SlintModelRowData> model;
    callback action_clicked(string);

    height: 50px;

    Rectangle {
        border-radius: 10px;
        background: root.model.selected ? #f4f4f5 : (row_hover.has-hover ? #fafafa : #ffffff);
        border-width: 1px;
        border-color: root.model.selected ? #d4d4d8 : (row_hover.has-hover ? #d4d4d8 : #e4e4e7);

        row_hover := TouchArea { }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 10px;
            spacing: 8px;
            alignment: space-between;

            // Short name, with the release date underneath.
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    horizontal-stretch: 1;

                    Text {
                        text: root.model.label;
                        color: #09090b;
                        font-size: 12px;
                        font-weight: 600;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    if root.model.verification_label != "": Text {
                        text: root.model.verification_label;
                        color: #ef4444;
                        font-size: 10px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                if root.model.status_text != "": Text {
                    text: root.model.status_text;
                    color: #a1a1aa;
                    font-size: 10px;
                    overflow: elide;
                }
            }

            // Selected badge. Same width and height as the action button so the column lines up.
            if root.model.selected: Rectangle {
                width: 96px;
                height: 26px;
                border-radius: 8px;
                background: #18181b;
                y: (parent.height - self.height) / 2;

                Text {
                    text: "✓ Selected";
                    color: #fafafa;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            // Select, Download, or live progress (percent / Extracting) — all on this button.
            if !root.model.selected && root.model.action_label != "": Rectangle {
                width: 96px;
                height: 26px;
                border-radius: 8px;
                clip: true;
                background: !root.model.action_enabled ? #f4f4f5 : (action_touch.pressed ? #e4e4e7 : (action_touch.has-hover ? #f4f4f5 : #ffffff));
                border-width: 1px;
                border-color: #e4e4e7;
                y: (parent.height - self.height) / 2;

                if root.model.is_in_progress && root.model.progress_percent >= 0: Rectangle {
                    x: 0;
                    y: 0;
                    width: parent.width * (root.model.progress_percent / 100);
                    height: parent.height;
                    background: #d4d4d8;
                }

                Text {
                    text: root.model.action_label;
                    color: #18181b;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    overflow: elide;
                }

                action_touch := TouchArea {
                    enabled: root.model.action_enabled;
                    mouse-cursor: pointer;
                    clicked => {
                        root.action_clicked(root.model.id);
                    }
                }
            }
        }
    }
}
