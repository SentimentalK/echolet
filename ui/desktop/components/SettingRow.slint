export component SettingToggle {
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <bool> checked: false;
    callback toggled(bool);

    height: root.subtitle != "" ? 40px : 32px;

    HorizontalLayout {
        alignment: space-between;

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            width: 250px;

            Text {
                text: root.title;
                color: #09090b;
                font-size: 12px;
                font-weight: 600;
                overflow: elide;
            }

            if root.subtitle != "": Text {
                text: root.subtitle;
                color: #71717a;
                font-size: 10px;
                overflow: elide;
            }
        }

        // Toggle Switch
        Rectangle {
            width: 36px;
            height: 20px;
            border-radius: 10px;
            background: root.checked ? #18181b : #e4e4e7;
            y: (parent.height - self.height) / 2;
            animate background { duration: 150ms; }

            // Knob
            Rectangle {
                x: root.checked ? 18px : 2px;
                y: 2px;
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: #ffffff;
                drop-shadow-blur: 2px;
                drop-shadow-offset-y: 1px;
                drop-shadow-color: #00000026;
                animate x { duration: 150ms; }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.toggled(!root.checked);
                }
            }
        }
    }
}

export struct IdleOption {
    minutes: int,
    label: string,
}

export component SettingIdleUnload {
    in property <string> current_label: "10 minutes";
    in property <int> current_minutes: 10;
    in-out property <bool> is_expanded: false;

    callback idle_selected(int);

    VerticalLayout {
        spacing: 6px;

        HorizontalLayout {
            height: 40px;
            alignment: space-between;

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                width: 190px;

                Text {
                    text: "Release Model After Inactivity";
                    color: #09090b;
                    font-size: 12px;
                    font-weight: 600;
                    overflow: elide;
                }

                Text {
                    text: "Free memory when idle";
                    color: #71717a;
                    font-size: 10px;
                    overflow: elide;
                }
            }

            Rectangle {
                width: 104px;
                height: 28px;
                border-radius: 8px;
                background: idle_toggle.has-hover ? #fafafa : #ffffff;
                border-width: 1px;
                border-color: root.is_expanded ? #18181b : #e4e4e7;
                y: (parent.height - self.height) / 2;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 8px;
                    alignment: space-between;

                    Text {
                        text: root.current_label;
                        color: #09090b;
                        font-size: 11px;
                        font-weight: 500;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Text {
                        text: root.is_expanded ? "▲" : "▼";
                        color: #a1a1aa;
                        font-size: 8px;
                        vertical-alignment: center;
                    }
                }

                idle_toggle := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.is_expanded = !root.is_expanded;
                    }
                }
            }
        }

        if root.is_expanded: Rectangle {
            border-radius: 8px;
            background: #ffffff;
            border-width: 1px;
            border-color: #e4e4e7;
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #0000000f;
            clip: true;

            VerticalLayout {
                padding: 4px;
                spacing: 1px;

                for opt in [
                    { minutes: 0, label: "Immediate" },
                    { minutes: 1, label: "1 minute" },
                    { minutes: 5, label: "5 minutes" },
                    { minutes: 10, label: "10 minutes" },
                    { minutes: 30, label: "30 minutes" },
                    { minutes: -1, label: "Never" },
                ]: Rectangle {
                    height: 26px;
                    border-radius: 6px;
                    background: (opt.minutes == root.current_minutes) ? #f4f4f5 : (idle_touch.has-hover ? #fafafa : transparent);

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: space-between;

                        Text {
                            text: opt.label;
                            color: (opt.minutes == root.current_minutes) ? #09090b : #3f3f46;
                            font-size: 11px;
                            font-weight: (opt.minutes == root.current_minutes) ? 600 : 400;
                            vertical-alignment: center;
                        }

                        if opt.minutes == root.current_minutes: Text {
                            text: "✓";
                            color: #09090b;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }

                    idle_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.is_expanded = false;
                            root.idle_selected(opt.minutes);
                        }
                    }
                }
            }
        }
    }
}

export component SettingAction {
    in property <string> label: "Open History Folder";
    callback clicked();

    height: 30px;

    Rectangle {
        border-radius: 8px;
        background: btn_touch.pressed ? #e4e4e7 : (btn_touch.has-hover ? #f4f4f5 : #ffffff);
        border-width: 1px;
        border-color: #e4e4e7;

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            alignment: center;

            Text {
                text: root.label + "  →";
                color: #18181b;
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        btn_touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }
    }
}
