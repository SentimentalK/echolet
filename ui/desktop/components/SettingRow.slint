export component SettingToggle {
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <bool> checked: false;
    callback toggled(bool);

    height: 32px;

    HorizontalLayout {
        alignment: space-between;

        VerticalLayout {
            alignment: center;
            spacing: 1px;
            width: 280px;

            Text {
                text: root.title;
                color: #e4e4e7;
                font-size: 12px;
                font-weight: 500;
                overflow: elide;
            }

            if root.subtitle != "": Text {
                text: root.subtitle;
                color: #71717a;
                font-size: 10px;
                overflow: elide;
            }
        }

        // Toggle Switch
        Rectangle {
            width: 36px;
            height: 20px;
            border-radius: 10px;
            background: root.checked ? #2563eb : #27272a;
            border-width: 1px;
            border-color: root.checked ? #3b82f6 : #3f3f46;
            y: (parent.height - self.height) / 2;

            // Knob
            Rectangle {
                x: root.checked ? 18px : 2px;
                y: 2px;
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: #ffffff;
                animate x { duration: 150ms; }
            }

            TouchArea {
                clicked => {
                    root.toggled(!root.checked);
                }
            }
        }
    }
}

export struct IdleOption {
    minutes: int,
    label: string,
}

export component SettingIdleUnload {
    in property <string> current_label: "10 minutes";
    in property <int> current_minutes: 10;
    in-out property <bool> is_expanded: false;

    callback idle_selected(int);

    VerticalLayout {
        spacing: 2px;

        HorizontalLayout {
            height: 28px;
            alignment: space-between;

            VerticalLayout {
                alignment: center;
                Text {
                    text: "Release Model After Inactivity";
                    color: #e4e4e7;
                    font-size: 12px;
                    font-weight: 500;
                    overflow: elide;
                }
            }

            Rectangle {
                width: 100px;
                height: 22px;
                border-radius: 4px;
                background: #27272a;
                border-width: 1px;
                border-color: root.is_expanded ? #3b82f6 : #3f3f46;
                y: (parent.height - self.height) / 2;

                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    alignment: space-between;

                    Text {
                        text: root.current_label;
                        color: #d4d4d8;
                        font-size: 10px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Text {
                        text: root.is_expanded ? "▲" : "▼";
                        color: #71717a;
                        font-size: 8px;
                        vertical-alignment: center;
                    }
                }

                TouchArea {
                    clicked => {
                        root.is_expanded = !root.is_expanded;
                    }
                }
            }
        }

        if root.is_expanded: Rectangle {
            border-radius: 6px;
            background: #18181b;
            border-width: 1px;
            border-color: #3f3f46;
            clip: true;

            VerticalLayout {
                padding-top: 2px;
                padding-bottom: 2px;
                spacing: 1px;

                for opt in [
                    { minutes: 0, label: "Immediate" },
                    { minutes: 1, label: "1 minute" },
                    { minutes: 5, label: "5 minutes" },
                    { minutes: 10, label: "10 minutes" },
                    { minutes: 30, label: "30 minutes" },
                    { minutes: -1, label: "Never" },
                ]: Rectangle {
                    height: 22px;
                    background: (opt.minutes == root.current_minutes) ? #27272a : (idle_touch.has-hover ? #1f1f23 : transparent);

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: space-between;

                        Text {
                            text: opt.label;
                            color: (opt.minutes == root.current_minutes) ? #3b82f6 : #d4d4d8;
                            font-size: 11px;
                            vertical-alignment: center;
                        }

                        if opt.minutes == root.current_minutes: Text {
                            text: "✓";
                            color: #3b82f6;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }

                    idle_touch := TouchArea {
                        clicked => {
                            root.is_expanded = false;
                            root.idle_selected(opt.minutes);
                        }
                    }
                }
            }
        }
    }
}

export component SettingAction {
    in property <string> label: "Open History Folder";
    callback clicked();

    height: 26px;

    Rectangle {
        border-radius: 4px;
        background: btn_touch.pressed ? #27272a : (btn_touch.has-hover ? #2e2e33 : #27272a);
        border-width: 1px;
        border-color: #3f3f46;

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            alignment: center;

            Text {
                text: root.label;
                color: #e4e4e7;
                font-size: 11px;
                font-weight: 500;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        btn_touch := TouchArea {
            clicked => {
                root.clicked();
            }
        }
    }
}
