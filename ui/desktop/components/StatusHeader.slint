export component StatusHeader {
    in property <string> title: "Echolet";
    in property <string> status_text: "Status: Ready";
    in property <bool> is_listening: false;

    height: 26px;

    HorizontalLayout {
        alignment: space-between;

        Text {
            text: root.title;
            color: #f4f4f5;
            font-size: 15px;
            font-weight: 700;
            vertical-alignment: center;
        }

        Rectangle {
            height: 22px;
            border-radius: 4px;
            background: root.is_listening ? #450a0a : #27272a;
            border-width: 1px;
            border-color: root.is_listening ? #dc2626 : #3f3f46;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                alignment: center;

                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: root.is_listening ? #ef4444 : #10b981;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: root.status_text;
                    color: root.is_listening ? #fecaca : #a1a1aa;
                    font-size: 11px;
                    font-weight: 500;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
