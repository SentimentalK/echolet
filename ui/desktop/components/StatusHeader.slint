// Header brand + status pill. Light theme inspired by reliquary.sentimentalk.com.
export component StatusHeader {
    in property <string> title: "Echolet";
    in property <string> status_text: "Status: Ready";
    in property <bool> is_listening: false;

    height: 28px;

    HorizontalLayout {
        spacing: 10px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 9px;
            alignment: start;

            // Logo mark
            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 7px;
                background: #18181b;
                y: (parent.height - self.height) / 2;

                Text {
                    text: "E";
                    color: #fafafa;
                    font-size: 14px;
                    font-weight: 900;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.title;
                color: #09090b;
                font-size: 16px;
                font-weight: 800;
                letter-spacing: -0.3px;
                vertical-alignment: center;
            }
        }

        // Status pill
        Rectangle {
            height: 24px;
            border-radius: 12px;
            background: root.is_listening ? #fef2f2 : #ffffff;
            border-width: 1px;
            border-color: root.is_listening ? #fecaca : #e4e4e7;
            y: (parent.height - self.height) / 2;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 6px;
                alignment: center;

                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: root.is_listening ? #ef4444 : #10b981;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: root.status_text;
                    color: root.is_listening ? #b91c1c : #52525b;
                    font-size: 11px;
                    font-weight: 500;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}
