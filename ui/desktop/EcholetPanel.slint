import { ScrollView } from "std-widgets.slint";
import { StatusHeader } from "components/StatusHeader.slint";
import { ModelGroup, SlintModelGroupData } from "components/ModelGroup.slint";
import { SlintModelRowData } from "components/ModelRow.slint";
import { LanguageSelector, SlintLanguageOptionData } from "components/LanguageSelector.slint";
import { SettingToggle, SettingIdleUnload, SettingAction } from "components/SettingRow.slint";

export { SlintModelRowData, SlintModelGroupData, SlintLanguageOptionData }

export component EcholetPanel inherits Window {
    width: 380px;
    height: 520px;
    title: "Echolet";
    no-frame: true;
    always-on-top: true;
    background: #18181b;
    default-font-size: 13px;

    in property <string> status_text: "Status: Ready";
    in property <bool> is_listening: false;
    in property <bool> listening_enabled: true;
    in property <[SlintModelGroupData]> model_groups: [];
    in property <bool> has_language_options: false;
    in property <string> language_model_id: "";
    in property <string> current_language_label: "Auto";
    in property <[SlintLanguageOptionData]> language_options: [];
    in property <bool> preload_on_startup: false;
    in property <int> idle_unload_minutes: 10;
    in property <string> idle_unload_label: "10 minutes";
    in property <bool> history_enabled: false;
    in property <string> footer_text: "Echolet · Slint 1.18.1 · 380px";

    callback close_requested();
    callback toggle_listening();
    callback diagnostic_clicked();
    callback model_action_clicked(string);
    callback language_selected(string, string);
    callback set_preload_startup(bool);
    callback set_idle_unload(int);
    callback set_history_enabled(bool);
    callback open_history_folder();

    forward-focus: key_handler;

    key_handler := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close_requested();
                return accept;
            }
            return reject;
        }

        // Fixed 380px width panel boundary
        Rectangle {
            width: 380px;
            height: 520px;
            border-width: 1px;
            border-color: #3f3f46;
            border-radius: 8px;
            background: #18181b;
            clip: true;

            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 0px;
                padding-bottom: 12px;
                spacing: 8px;

                // 1. Header. Drag this strip to move the borderless window.
                Rectangle {
                    height: 40px;

                    WindowMoveArea {
                        HorizontalLayout {
                            padding-top: 10px;
                            spacing: 8px;
                            alignment: space-between;

                            StatusHeader {
                                horizontal-stretch: 1;
                                title: "Echolet";
                                status_text: root.status_text;
                                is_listening: root.is_listening;
                            }

                            Rectangle {
                                width: 22px;
                                height: 22px;
                                border-radius: 4px;
                                background: close_touch.has-hover ? #3f3f46 : transparent;

                                Text {
                                    text: "×";
                                    color: close_touch.has-hover ? #f4f4f5 : #a1a1aa;
                                    font-size: 16px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                close_touch := TouchArea {
                                    clicked => {
                                        root.close_requested();
                                    }
                                }
                            }
                        }
                    }
                }

                // Divider
                Rectangle {
                    height: 1px;
                    background: #27272a;
                }

                // 2. Scrollable Body
                ScrollView {
                    VerticalLayout {
                        spacing: 10px;
                        padding-right: 4px;

                        // Model Section (Hierarchical Groups)
                        VerticalLayout {
                            spacing: 8px;

                            for group in root.model_groups: ModelGroup {
                                group: group;
                                action_clicked(id) => {
                                    root.model_action_clicked(id);
                                }
                            }
                        }

                        // Language Section (only when selected model has options)
                        if root.has_language_options: VerticalLayout {
                            spacing: 8px;

                            Rectangle {
                                height: 1px;
                                background: #27272a;
                            }

                            LanguageSelector {
                                model_id: root.language_model_id;
                                current_label: root.current_language_label;
                                options: root.language_options;
                                language_selected(model_id, locale) => {
                                    root.language_selected(model_id, locale);
                                }
                            }
                        }

                        // Settings Divider
                        Rectangle {
                            height: 1px;
                            background: #27272a;
                        }

                        // Settings Section
                        VerticalLayout {
                            spacing: 6px;

                            HorizontalLayout {
                                height: 16px;
                                Text {
                                    text: "Settings";
                                    color: #71717a;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }

                            SettingToggle {
                                title: "Faster First Dictation";
                                subtitle: "Load selected model when Echolet starts";
                                checked: root.preload_on_startup;
                                toggled(checked) => {
                                    root.set_preload_startup(checked);
                                }
                            }

                            SettingIdleUnload {
                                current_label: root.idle_unload_label;
                                current_minutes: root.idle_unload_minutes;
                                idle_selected(mins) => {
                                    root.set_idle_unload(mins);
                                }
                            }

                            SettingToggle {
                                title: "Local History";
                                subtitle: "";
                                checked: root.history_enabled;
                                toggled(checked) => {
                                    root.set_history_enabled(checked);
                                }
                            }

                            HorizontalLayout {
                                alignment: start;
                                SettingAction {
                                    label: "Open History Folder";
                                    clicked => {
                                        root.open_history_folder();
                                    }
                                }
                            }
                        }
                    }
                }

                // Divider before footer
                Rectangle {
                    height: 1px;
                    background: #27272a;
                }

                // 3. Footer / Listening Control
                VerticalLayout {
                    spacing: 6px;

                    Rectangle {
                        height: 32px;
                        border-radius: 6px;
                        background: !root.listening_enabled ? #27272a : root.is_listening ? (mic_touch.pressed ? #991b1b : #dc2626) : (mic_touch.pressed ? #1d4ed8 : (mic_touch.has-hover ? #2563eb : #1d4ed8));
                        border-width: 1px;
                        border-color: !root.listening_enabled ? #3f3f46 : root.is_listening ? #ef4444 : #3b82f6;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;

                            Text {
                                text: root.is_listening ? "Stop Listening (F10)" : "Start Listening (F10)";
                                color: !root.listening_enabled ? #71717a : #ffffff;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }

                        mic_touch := TouchArea {
                            enabled: root.listening_enabled;
                            clicked => {
                                root.toggle_listening();
                            }
                        }
                    }

                    HorizontalLayout {
                        height: 14px;
                        alignment: center;

                        Text {
                            text: root.footer_text;
                            color: #52525b;
                            font-size: 10px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}
